MONGO_URI=mongodb://localhost:27017/agrolink
# Must be a random string of at least 32 characters
JWT_SECRET=change_this_to_a_long_random_secret_key_min_32_chars
JWT_EXPIRE=7d
JWT_SESSION_EXPIRE=1d
PORT=5000
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# EMI defaults are now managed by admins in Settings; these only apply if no setting is stored
MIN_EMI_ELIGIBLE_AMOUNT=5000
EMI_DEFAULT_INTEREST_RATE=8.5

# Razorpay (leave blank for clearly-labelled TEST MODE: no real money, payments marked as test)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required only if you configure the Razorpay webhook (POST /api/payments/webhook)
RAZORPAY_WEBHOOK_SECRET=
# Set to true to allow test-mode payments when NODE_ENV=production (not recommended)
ALLOW_TEST_PAYMENTS=false

# Used only by `npm run seed:admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
